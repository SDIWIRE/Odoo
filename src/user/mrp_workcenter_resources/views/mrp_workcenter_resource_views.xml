<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Worker Resource Slot list view -->
    <record id="view_mrp_workcenter_worker_resource_tree" model="ir.ui.view">
        <field name="name">mrp.workcenter.worker.resource.list</field>
        <field name="model">mrp.workcenter.worker.resource</field>
        <field name="arch" type="xml">
            <list string="Worker Resource Slots" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="workcenter_id" optional="show"/>
                <field name="name" optional="show"/>
                <field name="resource_id" optional="show"/>
                <field name="active" optional="show"/>
            </list>
        </field>
    </record>

    <!-- Worker Resource Slot action (used by stat button on work center form) -->
    <record id="action_mrp_workcenter_worker_resource" model="ir.actions.act_window">
        <field name="name">Worker Resource Slots</field>
        <field name="res_model">mrp.workcenter.worker.resource</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No worker slots yet.
            </p>
            <p>
                Set <strong>Number of Workers</strong> on the work center form
                and save to generate slots automatically.
            </p>
        </field>
    </record>

    <!-- Management list: Manufacturing > Configuration > Work Center Workers -->
    <record id="view_mrp_workcenter_workers_management_tree" model="ir.ui.view">
        <field name="name">mrp.workcenter.workers.management.list</field>
        <field name="model">mrp.workcenter</field>
        <field name="arch" type="xml">
            <list string="Work Center Workers"
                  editable="bottom"
                  multi_edit="1"
                  decoration-warning="worker_slot_count != number_of_workers">
                <field name="name" readonly="1"/>
                <field name="code" readonly="1" optional="show"/>
                <field name="time_efficiency" readonly="1" optional="show"/>
                <field name="number_of_workers" string="Workers (target)"/>
                <field name="worker_slot_count" string="Slots configured" readonly="1"/>
                <button name="action_sync_worker_resources"
                        string="Sync"
                        type="object"
                        icon="fa-refresh"
                        help="Sync resource slots to match the target worker count."/>
            </list>
        </field>
    </record>

    <record id="action_mrp_workcenter_workers_management" model="ir.actions.act_window">
        <field name="name">Work Center Workers</field>
        <field name="res_model">mrp.workcenter</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_mrp_workcenter_workers_management_tree"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No work centers found.
            </p>
            <p>
                Set the number of workers on each work center so the scheduler
                knows how many jobs can run simultaneously.
            </p>
        </field>
    </record>

    <menuitem id="menu_mrp_workcenter_workers"
              name="Work Center Workers"
              parent="mrp.menu_mrp_configuration"
              action="action_mrp_workcenter_workers_management"
              sequence="25"/>

</odoo>
