<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_production_form_inherit_partial_transfer" model="ir.ui.view">
        <field name="name">mrp.production.form.partial.transfer</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">

            <!-- Add button in the status bar area next to Validate -->
            <xpath expr="//button[@name='button_mark_done']" position="before">
                <button name="action_partial_transfer_to_stock"
                        string="Transfer Partial to Stock"
                        type="object"
                        class="btn-primary"
                        invisible="not show_partial_transfer_button"
                        icon="fa-truck"
                        help="Move a partial quantity of finished goods to stock now, keeping this order open for the remaining quantity."/>
            </xpath>

            <!-- Add summary fields below the main qty fields -->
            <xpath expr="//field[@name='qty_producing']" position="after">
                <field name="qty_transferred_to_stock"
                       readonly="1"
                       invisible="qty_transferred_to_stock == 0"
                       string="Already Transferred to Stock"/>
                <field name="qty_remaining_to_produce"
                       readonly="1"
                       invisible="qty_transferred_to_stock == 0"
                       string="Still to Produce"/>
                <!-- Hidden field needed for button visibility compute -->
                <field name="show_partial_transfer_button" invisible="1"/>
            </xpath>

        </field>
    </record>
</odoo>
