<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_production_form_inherit_partial_transfer" model="ir.ui.view">
        <field name="name">mrp.production.form.partial.transfer</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">

            <!-- Button next to Validate -->
            <xpath expr="//button[@name='button_mark_done']" position="before">
                <button name="action_partial_transfer_to_stock"
                        string="Transfer Partial to Stock"
                        type="object"
                        class="btn-primary"
                        invisible="not show_partial_transfer_button"
                        icon="fa-truck"
                        help="Move a partial quantity of finished goods to stock now, keeping this order open for the remaining quantity."/>
            </xpath>

            <!-- Hidden control fields -->
            <xpath expr="//field[@name='product_qty']" position="after">
                <field name="show_partial_transfer_button" invisible="1"/>
                <field name="qty_progress_pct" invisible="1"/>
                <field name="qty_transferred_to_stock" invisible="1"/>
                <field name="qty_remaining_to_produce" invisible="1"/>
            </xpath>

            <!-- Running total — inject before the notebook (tabs) so it
                 always appears between the header fields and the Components tab -->
            <xpath expr="//notebook" position="before">
                <group string="Transfer Progress"
                       invisible="qty_transferred_to_stock == 0"
                       col="4">
                    <field name="qty_transferred_to_stock"
                           readonly="1"
                           string="Transferred to Stock"/>
                    <field name="qty_remaining_to_produce"
                           readonly="1"
                           string="Remaining to Produce"/>
                    <field name="product_qty"
                           readonly="1"
                           string="Total Ordered"/>
                    <field name="qty_progress_pct"
                           readonly="1"
                           string="% Complete"
                           widget="percentage"/>
                </group>
            </xpath>

        </field>
    </record>
</odoo>
