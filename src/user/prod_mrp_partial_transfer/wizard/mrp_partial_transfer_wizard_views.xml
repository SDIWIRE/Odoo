<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_partial_transfer_wizard_view_form" model="ir.ui.view">
        <field name="name">mrp.partial.transfer.wizard.form</field>
        <field name="model">mrp.partial.transfer.wizard</field>
        <field name="arch" type="xml">
            <form string="Transfer Partial Quantity to Stock">
                <sheet>
                    <group>
                        <group string="Manufacturing Order">
                            <field name="production_id" readonly="1"/>
                            <field name="product_id" readonly="1"/>
                            <field name="product_uom_id" readonly="1"
                                   string="Unit of Measure"/>
                        </group>
                        <group string="Quantities">
                            <field name="qty_remaining"
                                   readonly="1"
                                   string="Remaining to Produce"/>
                            <field name="qty_to_transfer"
                                   string="Quantity to Transfer Now"
                                   required="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Destination">
                            <field name="location_dest_id"
                                   string="Transfer to Location"/>
                            <field name="lot_id"
                                   invisible="product_id.tracking == 'none'"
                                   string="Lot / Serial Number"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert">
                        <p>
                            This will move the specified quantity of finished goods
                            into stock <strong>immediately</strong>, while keeping
                            the Manufacturing Order open for the remaining quantity.
                        </p>
                        <p>
                            Components will be consumed proportionally for the
                            transferred quantity.
                        </p>
                    </div>
                </sheet>
                <footer>
                    <button name="action_confirm_transfer"
                            string="Transfer to Stock"
                            type="object"
                            class="btn-primary"
                            data-hotkey="q"/>
                    <button string="Cancel"
                            class="btn-secondary"
                            special="cancel"
                            data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
