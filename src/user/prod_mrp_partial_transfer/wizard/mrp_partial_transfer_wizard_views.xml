<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_partial_transfer_wizard_view_form" model="ir.ui.view">
        <field name="name">mrp.partial.transfer.wizard.form</field>
        <field name="model">mrp.partial.transfer.wizard</field>
        <field name="arch" type="xml">
            <form string="Transfer Partial Quantity to Stock">
                <sheet>
                    <group>
                        <group string="Manufacturing Order">
                            <field name="production_id" readonly="1"/>
                            <field name="product_id"/>
                            <field name="product_uom_id" string="Unit"/>
                        </group>
                        <group string="Quantities">
                            <field name="qty_ordered"/>
                            <field name="qty_done"/>
                            <field name="qty_remaining"/>
                            <field name="qty_to_transfer"/>
                            <field name="is_final" invisible="1"/>
                        </group>
                    </group>
                    <group string="Options">
                        <field name="allow_component_shortage"/>
                        <field name="accept_consumption_differences" invisible="not is_final"/>
                    </group>
                    <div class="alert alert-info" role="alert" invisible="is_final">
                        This posts the quantity on the Manufacturing Order, consumes the
                        components for it, and puts the finished goods away in stock.
                        The MO stays open for the rest.
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="not is_final">
                        This is the remaining quantity: the Manufacturing Order will be
                        closed with the standard Mark as Done.
                    </div>
                </sheet>
                <footer>
                    <button name="action_confirm_transfer" string="Transfer to Stock"
                            type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
